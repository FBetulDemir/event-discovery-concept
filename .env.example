# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Supabase project "monkey-match" (Settings -> API). The publishable key is safe in the browser,
# access control is enforced by RLS. Never put a service_role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Ticketmaster key belongs in Supabase Edge Function Secrets, not in this file.
# See docs/BACKEND.md. The Next server calls that function using the publishable key above.

# External event sources (server-side only, no NEXT_PUBLIC_ prefix).
# Göteborg & Co GraphQL subscription key (adapter lands once a key is available).
GOTEBORGCO_API_KEY=
